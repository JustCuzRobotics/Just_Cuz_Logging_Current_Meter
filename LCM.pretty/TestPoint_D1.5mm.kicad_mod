(footprint "TestPoint_D1.5mm"
  (version 20231120)
  (generator "lcm_gen")
  (layer "F.Cu")
  (descr "Probe pad, 1.5 mm bare copper. No paste aperture, so reflow leaves it flat and it stays probe-friendly.")
