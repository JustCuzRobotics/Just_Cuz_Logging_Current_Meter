    (effects (font (size 0.8 0.8) (thickness 0.12))))
  (fp_text user "${REFERENCE}" (at 0 -2.2) (layer "F.Fab")
    (effects (font (size 0.8 0.8) (thickness 0.12))))
  (fp_circle (center 0 0) (end 1.15 0) (stroke (width 0.12) (type solid)) (fill none) (layer "F.SilkS"))
  (fp_circle (center 0 0) (end 1.5 0) (stroke (width 0.05) (type solid)) (fill none) (layer "F.CrtYd"))
  (pad "1" smd circle (at 0 0) (size 1.5 1.5) (layers "F.Cu" "F.Mask"))
)
